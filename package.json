{
  "name": "codethrough",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/configs/*",
    "packages/libs/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:landing": "turbo run build --filter=@codethrough/landing",
    "dev": "turbo run dev",
    "check": "turbo run check",
    "preview": "turbo run preview",
    "deploy": "turbo run deploy",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "turbo run test:e2e",
    "test:lhci": "turbo run test:lhci",
    "lint": "turbo run lint lint:css",
    "format:check": "turbo run format:check",
    "format": "oxfmt --write --ignore-path .gitignore '**/*.{ts,tsx,js,mjs,cjs}'"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "postcss-html": "2.0.0",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "turbo": "2.10.10",
    "typescript": "7.0.2"
  },
  "overrides": {
    "devalue": "5.8.1",
    "playwright-core": "1.59.1"
  },
  "packageManager": "bun@1.4.0-canary.1+46c54cd69",
  "engines": {
    "node": ">=22.0.0"
  }
}
