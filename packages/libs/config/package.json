{
  "name": "@codethrough/config",
  "version": "0.0.1",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsgo --noEmit -p tsconfig.json && tsgo --noEmit -p tests/unit/tsconfig.json",
    "lint": "oxlint --config ../../../.oxlintrc.json --deny-warnings --report-unused-disable-directives",
    "format:check": "oxfmt --check --ignore-path ../../../.gitignore '**/*.{ts,tsx,js,mjs,cjs}'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "convict": "6.2.5",
    "convict-format-with-validator": "6.2.0"
  },
  "devDependencies": {
    "@codethrough/tsconfig": "workspace:*",
    "@typescript/native-preview": "7.0.0-dev.20260620.1",
    "@types/bun": "1.3.12",
    "@types/convict": "6.1.6",
    "@types/convict-format-with-validator": "6.0.5",
    "@vitest/coverage-istanbul": "5.0.0-beta.5",
    "typescript": "5.9.2",
    "vitest": "5.0.0-beta.5"
  }
}
