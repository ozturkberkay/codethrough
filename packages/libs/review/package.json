{
  "name": "@codethrough/review",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "types": "./src/index.tsx",
  "exports": {
    ".": "./src/index.tsx"
  },
  "scripts": {
    "build": "tsgo --noEmit -p tsconfig.json",
    "check": "tsgo --noEmit -p tsconfig.json && tsgo --noEmit -p tests/unit/tsconfig.json",
    "lint": "oxlint --config ../../../.oxlintrc.json --deny-warnings --report-unused-disable-directives",
    "format:check": "oxfmt --check --ignore-path ../../../.gitignore '**/*.{ts,tsx,js,mjs,cjs}'",
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "playwright:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@pierre/diffs": "1.2.11",
    "@codethrough/design-tokens": "workspace:*",
    "@codethrough/schema": "workspace:*",
    "@codethrough/unocss-config": "workspace:*",
    "@unocss/preset-wind4": "66.7.2",
    "@unocss/vite": "66.7.2",
    "lru_map": "0.4.1",
    "solid-js": "1.9.13",
    "unocss": "66.7.2"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@codethrough/tsconfig": "workspace:*",
    "@typescript/native-preview": "7.0.0-dev.20260620.1",
    "@types/bun": "1.3.14",
    "@vitest/coverage-istanbul": "5.0.0-beta.5",
    "rolldown": "1.1.2",
    "typescript": "6.0.3",
    "vite": "8.1.0-beta.0",
    "vite-plugin-solid": "2.11.12",
    "vitest": "5.0.0-beta.5"
  }
}
