{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@codethrough/tsconfig/base",
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "lib": ["ES2024", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["vite/client", "bun"],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["src", "tests", "vite.config.ts", "uno.config.ts", "playwright.config.ts"]
}
