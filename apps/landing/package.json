{
  "name": "@codethrough/landing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build",
    "dev": "astro dev",
    "check": "astro check --minimumFailingSeverity=hint && tsgo --noEmit -p tsconfig.json",
    "lint": "oxlint --config ../../.oxlintrc.json --deny-warnings --report-unused-disable-directives",
    "lint:css": "stylelint --cache --allow-empty-input --max-warnings 0 --report-needless-disables --report-invalid-scope-disables --ignore-path ../../.stylelintignore '**/*.{css,astro}'",
    "format:check": "oxfmt --check --ignore-path ../../.gitignore '**/*.{ts,tsx,js,mjs,cjs}'",
    "preview": "astro preview",
    "playwright:install": "playwright install --with-deps chromium firefox webkit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:e2e": "playwright test",
    "test:lhci": "cd ../.. && lhci autorun"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@iconify-json/ph": "1.2.2",
    "@iconify-json/simple-icons": "1.2.86",
    "@codethrough/design-tokens": "workspace:*",
    "@codethrough/unocss-config": "workspace:*",
    "@unocss/astro": "66.7.2",
    "@unocss/preset-wind4": "66.7.2",
    "@unocss/reset": "66.7.2",
    "astro": "6.4.8",
    "unocss": "66.7.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@axe-core/playwright": "4.11.3",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.61.0",
    "@codethrough/config": "workspace:*",
    "@codethrough/oxc-config": "workspace:*",
    "@codethrough/tsconfig": "workspace:*",
    "@typescript/native-preview": "7.0.0-dev.20260620.1",
    "@types/bun": "1.3.14",
    "@unocss/preset-attributify": "66.7.2",
    "@unocss/transformer-directives": "66.7.2",
    "@unocss/transformer-variant-group": "66.7.2",
    "@vitest/coverage-istanbul": "5.0.0-beta.5",
    "autoprefixer": "10.5.0",
    "png-to-ico": "3.0.1",
    "sharp": "0.35.2",
    "typescript": "6.0.3",
    "vitest": "5.0.0-beta.5"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ]
}
