---
import Header from "../components/header.astro";
import Footer from "../components/footer.astro";
import Base from "../layouts/base.astro";

const title = "Page not found - Codethrough";
const description = "The page you are looking for could not be found.";
// Canonical points at the homepage root so search engines do not index the
// 404 URL.
const canonical = "https://codethrough.dev/";
---

<Base title={title} description={description} canonical={canonical}>
  <Header />
  <main
    class="not-found flex flex-col items-center justify-center text-center py-20 min-h-[calc(100dvh-4rem)]"
  >
    <div id="main-content" tabindex="-1" class="container text-center">
      <p
        class="font-mono text-xs font-semibold uppercase tracking-widest text-zinc-400 mb-4"
      >
        404
      </p>
      <h1
        class="text-[clamp(2.5rem,5vw+1rem,4.25rem)] font-semibold leading-tight tracking-wide mb-6 max-w-[40rem] mx-auto"
      >
        Page not found
      </h1>
      <p
        class="text-[clamp(1rem,1vw+0.5rem,1.125rem)] leading-relaxed text-zinc-400 max-w-[32.5rem] mx-auto mb-12"
      >
        Try heading back home.
      </p>
      <a
        href="/"
        class="not-found-link inline-flex items-center gap-2 py-4 px-6 bg-zinc-50 text-zinc-950 rounded-xl text-base font-bold no-underline transition-[background-color,box-shadow] duration-200 hover:bg-zinc-400 kbd-focus shadow-[0_2px_8px_rgb(0_0_0/40%),0_12px_40px_rgb(0_0_0/40%),0_0_1.75rem_0.25rem_rgb(255_255_255/18%)]"
      >
        Return home
        <svg
          width="16"
          height="16"
          viewBox="0 0 16 16"
          fill="none"
          aria-hidden="true"
          class="transition-transform duration-200"
          ><path
            d="M3 8h10M9 4l4 4-4 4"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path></svg
        >
      </a>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .not-found-link:hover svg {
    transform: translateX(3px);
  }
</style>
