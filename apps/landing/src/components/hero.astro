---
// Monochrome, dark-only hero. Renders fully server-side with zero JS.
---

<section class="relative h-dvh overflow-hidden bg-zinc-950 text-zinc-50">
  <div data-spotlight aria-hidden="true" class="spotlight">
    <div class="dotfield"></div>
    <div class="glow"></div>
  </div>

  <div
    class="absolute inset-[clamp(1.5rem,5vw,4rem)] border border-white/8 rounded-[2px]"
  >
    <span aria-hidden="true" class="tick -top-[7px] -left-[7px]"></span>
    <span aria-hidden="true" class="tick -top-[7px] -right-[7px]"></span>
    <span aria-hidden="true" class="tick -bottom-[7px] -left-[7px]"></span>
    <span aria-hidden="true" class="tick -bottom-[7px] -right-[7px]"></span>

    <div class="absolute inset-0 grid place-items-center px-6">
      <div class="flex flex-col items-center text-center">
        <div
          data-fade-in
          class="flex items-center gap-[11px] mb-[clamp(1.25rem,3vw,1.875rem)]"
        >
          <svg
            viewBox="0 0 512 512"
            fill="currentColor"
            aria-hidden="true"
            class="size-[25px] block"
          >
            <path
              d="M 446,334.701 L 334.701,446 L 177.299,446 L 66,334.701 L 66,177.299 L 177.299,66 L 334.701,66 L 446,177.299 L 389.431,177.299 L 318.132,106 L 193.868,106 L 106,193.868 L 106,318.132 L 193.868,406 L 318.132,406 L 389.431,334.701 Z"
            ></path>
            <rect x="212.63" y="244" width="233.37" height="24"></rect>
            <circle cx="256" cy="256" r="45"></circle>
          </svg>
          <span class="text-lg font-semibold tracking-[-0.02em]"
            >Codethrough</span
          >
        </div>

        {
          /* LCP element: no data-fade-in so it paints immediately at full opacity. */
        }
        <h1
          class="text-[clamp(2.4rem,9vw,5.75rem)] font-semibold tracking-[-0.035em] leading-[0.98] text-balance"
        >
          Stop drowning<br />in pull requests
        </h1>

        <p
          data-fade-in
          class="delay-[60ms] mt-[clamp(1rem,2vw,1.625rem)] max-w-[660px] text-[clamp(1.0625rem,1.4vw,1.3125rem)] leading-[1.5] text-zinc-400 text-pretty"
        >
          Codethrough turns every pull request into a narrated walkthrough,
          explaining the changes in the order they're best reviewed.
        </p>

        <a
          data-fade-in
          href="https://github.com/getcodethrough/codethrough"
          class="delay-[120ms] mt-[clamp(1.5rem,3vw,2.25rem)] inline-flex items-center gap-[9px] h-11 px-5 rounded-[9px] bg-zinc-50 text-zinc-950 font-medium tracking-[-0.01em] no-underline kbd-focus"
        >
          <svg
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
            class="size-[17px] block"
          >
            <path
              d="M12 1.5C6.2 1.5 1.5 6.3 1.5 12.2c0 4.7 3 8.7 7.2 10.1.5.1.7-.2.7-.5v-1.7c-2.9.6-3.5-1.4-3.5-1.4-.5-1.2-1.2-1.6-1.2-1.6-.9-.7.1-.6.1-.6 1 .1 1.6 1.1 1.6 1.1.9 1.6 2.5 1.1 3.1.9.1-.7.4-1.1.6-1.4-2.3-.3-4.7-1.2-4.7-5.2 0-1.1.4-2.1 1.1-2.8-.1-.3-.5-1.4.1-2.9 0 0 .9-.3 2.9 1.1.8-.2 1.7-.4 2.6-.4.9 0 1.8.1 2.6.4 2-1.4 2.9-1.1 2.9-1.1.6 1.5.2 2.6.1 2.9.7.7 1.1 1.7 1.1 2.8 0 4-2.4 4.9-4.7 5.2.4.3.7.9.7 1.9v2.8c0 .3.2.6.7.5 4.2-1.4 7.2-5.4 7.2-10.1C22.5 6.3 17.8 1.5 12 1.5z"
            ></path>
          </svg>
          Get started
        </a>

        {/* TODO: add a "Demo" button beside this CTA that opens a pre-rendered PR walkthrough. */}
      </div>
    </div>
  </div>
</section>

<script>
  import { initSpotlight } from "../scripts/spotlight";
  initSpotlight();
</script>

<style>
  /*
   * Cursor-following light pool: a zero-size wrapper whose children (the dot
   * field and the glow) center on its origin, so ONE transform on the wrapper
   * moves both together and the move stays on the compositor. The rest
   * transform centers the pool at ~22%/92% (bottom-left) and MUST match REST in
   * spotlight.ts.
   */
  .spotlight {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    pointer-events: none;
    transform: translate3d(22vw, 92vh, 0);
  }

  /* Each child centers on the wrapper origin, which the script keeps on the
     cursor, so the dots and glow track the pointer as one pool. */
  .dotfield,
  .glow {
    position: absolute;
    top: 0;
    left: 0;
    transform: translate(-50%, -50%);
  }

  .dotfield {
    width: 60vmax;
    height: 60vmax;

    /* Dot alpha is a spotlight-specific one-off value, not a brand token. */
    background-image: radial-gradient(
      rgb(255 255 255 / 50%) 1px,
      transparent 1.4px
    );
    background-size: 13px 13px;

    /* black keyword (not a hex); closest-side, no `at` position (Autoprefixer-safe). */
    mask-image: radial-gradient(closest-side, black, transparent 62%);
  }

  .glow {
    width: 32.5rem;
    height: 20rem;
    border-radius: 50%;
    filter: blur(70px);

    /* Glow alpha is a spotlight-specific one-off value, not a brand token. */
    background: rgb(255 255 255 / 5%);
  }

  /* Corner crosshair ticks: generated content has no element to carry
     utilities, so the 1px cross is drawn here (an allowed scoped-style case). */
  .tick {
    position: absolute;
    width: 13px;
    height: 13px;
    color: theme("colors.zinc.600");
  }

  .tick::before,
  .tick::after {
    content: "";
    position: absolute;
    background: currentcolor;
  }

  .tick::before {
    left: 50%;
    top: 0;
    width: 1px;
    height: 100%;
    transform: translateX(-50%);
  }

  .tick::after {
    top: 50%;
    left: 0;
    width: 100%;
    height: 1px;
    transform: translateY(-50%);
  }
</style>
