{
  "name": "@codethrough/cli",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "bin": {
    "codethrough": "./src/main.ts"
  },
  "scripts": {
    "build": "vite build",
    "check": "tsgo --noEmit -p tsconfig.json && tsgo --noEmit -p frontend/tsconfig.json && tsgo --noEmit -p tests/unit/tsconfig.json && tsgo --noEmit -p tests/integration/tsconfig.json && tsgo --noEmit -p tests/e2e/tsconfig.json",
    "lint": "oxlint --config ../../.oxlintrc.json --deny-warnings --report-unused-disable-directives",
    "format:check": "oxfmt --check --ignore-path ../../.gitignore '**/*.{ts,tsx,js,mjs,cjs}'",
    "dev": "bun run src/main.ts",
    "start": "bun run src/main.ts",
    "build:binary": "bun run scripts/build.ts",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest",
    "test:coverage": "bun --bun vitest run --coverage",
    "test:e2e": "playwright test",
    "playwright:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@octokit/rest": "22.0.1",
    "@pierre/diffs": "1.2.11",
    "@codethrough/config": "workspace:*",
    "@codethrough/design-tokens": "workspace:*",
    "@codethrough/engine": "workspace:*",
    "@codethrough/github": "workspace:*",
    "@codethrough/model": "workspace:*",
    "@codethrough/review": "workspace:*",
    "@codethrough/schema": "workspace:*",
    "@codethrough/unocss-config": "workspace:*",
    "@unocss/preset-wind4": "66.7.2",
    "@unocss/vite": "66.7.2",
    "lru_map": "0.4.1",
    "solid-js": "1.9.3",
    "unocss": "66.7.2",
    "valibot": "1.4.1"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@codethrough/tsconfig": "workspace:*",
    "@typescript/native-preview": "7.0.0-dev.20260620.1",
    "@types/bun": "1.3.12",
    "@vitest/coverage-istanbul": "5.0.0-beta.5",
    "rolldown": "1.1.2",
    "typescript": "5.9.2",
    "vite": "8.1.0-beta.0",
    "vite-plugin-solid": "2.11.12",
    "vitest": "5.0.0-beta.5"
  }
}
